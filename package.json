{
  "name": "clay-doc",
  "version": "5.1.0",
  "description": "Documentation sites from Markdown: write docs, get a fast, searchable, SEO-ready static site.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clay-doc/clay.git"
  },
  "type": "module",
  "bin": {
    "clay": "bin/clay.mjs",
    "clay-doc": "bin/clay.mjs"
  },
  "files": [
    "bin",
    "app",
    "common",
    "lib",
    "modules",
    "server",
    "nuxt.config.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "node bin/clay.mjs preview --root playground",
    "test": "vitest run",
    "test:e2e": "CLAY_BASE_URL=/clay/ node bin/clay.mjs build --root playground --strict && playwright test",
    "typecheck": "nuxt typecheck",
    "prepare": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@napi-rs/canvas": "^1.0.10",
    "@scalar/openapi-upgrader": "^0.4.4",
    "@scalar/openapi-validator": "^0.1.12",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "beautiful-mermaid": "^1.1.3",
    "daisyui": "^5.7.50",
    "dompurify": "^3.4.17",
    "github-slugger": "^2.0.0",
    "jiti": "^2.7.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "marked-alert": "^2.1.2",
    "marked-shiki": "^1.2.1",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "nitropack": "^2.13.5",
    "nuxt": "^4.6.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.9",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
